<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.eventticketapp.gui.coordinatorControllers.eventManagement.IssuedTicketsController">
    <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Label fx:id="titleLabel" styleClass="display-title" HBox.hgrow="ALWAYS" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnDeleteTicket" mnemonicParsing="false" onAction="#onDeleteTicket" styleClass="create-btn" text="🗑">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btnSeeTicket" onAction="#onSeeTicket" prefHeight="25.0" prefWidth="110.0" styleClass="create-btn" text="See Ticket" />
         </children>
      </HBox>
        <VBox styleClass="main-card" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
            <children>
                <TableView fx:id="tblIssuedTickets" styleClass="modern-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="columnName" prefWidth="166.0" text="Customer" />
                        <TableColumn fx:id="columnEmail" prefWidth="221.0" text="Email" />
                        <TableColumn fx:id="columnTicketType" prefWidth="243.0" text="Ticket Type" />
                        <TableColumn fx:id="columnQuantity" prefWidth="100.0" text="Quantity" />
                  <TableColumn fx:id="columnTotalPrice" prefWidth="100.0" text="Total Price" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>
