<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="ticketPaper" alignment="CENTER" spacing="15" style="-fx-padding: 25; -fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.eventticketapp.gui.coordinatorControllers.VoucherTicketController">

    <!-- ================= VOUCHER CARD ================= -->
    <HBox spacing="25" style="-fx-background-color: white;                  -fx-padding: 20;                  -fx-border-color: #ddd;                  -fx-border-radius: 10;                  -fx-background-radius: 10;                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0.2, 0, 3);">

        <!-- LEFT: STACKED INFO -->
        <VBox spacing="12" HBox.hgrow="ALWAYS">

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="🎟 VOUCHER" />

            <!-- STACKED FIELDS -->
            <VBox spacing="8">

                <VBox>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Name" />
                    <Label fx:id="lblVoucherName" style="-fx-font-size: 15px; -fx-font-weight: bold;" />
                </VBox>

                <VBox />

                <VBox>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Discount" />
                    <Label fx:id="lblDiscount" style="-fx-font-size: 14px;" />
                </VBox>

                <VBox>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Event" />
                    <Label fx:id="lblEvents" style="-fx-font-size: 14px;" />
                </VBox>

            </VBox>

        </VBox>

        <!-- RIGHT: QR + BARCODE -->
        <VBox alignment="CENTER" spacing="10">

            <ImageView fx:id="imgQRCode" fitHeight="120" fitWidth="120" preserveRatio="true" />

            <ImageView fx:id="imgBarcode" fitHeight="70" fitWidth="180" preserveRatio="true" />

        </VBox>

    </HBox>

    <!-- ================= BUTTONS ================= -->
    <HBox alignment="CENTER" spacing="15">

        <Button onAction="#onPrintTicket" style="-fx-font-size: 14px;" text="Print" />

    </HBox>

</VBox>
