<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="450.0" spacing="20.0" styleClass="main-card" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.eventticketapp.gui.coordinatorControllers.AddVoucherController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label styleClass="header-title" text="Create Special Voucher" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <VBox spacing="8.0">
        <Label styleClass="input-label" text="Voucher Name *" />
        <TextField fx:id="txtName" promptText="Free Beer, 50% Off Drink..." styleClass="modern-input" />
    </VBox>

    <VBox spacing="8.0">
      <VBox spacing="8.0">
         <children>
            <Label styleClass="input-label" text="Description *" />
            <TextArea fx:id="txtDescription" prefHeight="16.0" prefWidth="367.0" styleClass="modern-input" wrapText="true" />
         </children>
      </VBox>
      <VBox prefHeight="0.0" prefWidth="390.0">
         <children>
            <Label text="Discount Type">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <ComboBox fx:id="comboDiscountType" prefHeight="25.0" prefWidth="162.0" styleClass="modern-input">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </ComboBox>
            <Label text="Discount Value" />
            <TextField fx:id="txtDiscountValue" prefHeight="26.0" prefWidth="220.0" />
         </children>
      </VBox>
    </VBox>

    <HBox alignment="CENTER_LEFT" styleClass="toggle-container">
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label styleClass="input-label" text="Valid for All Events" />
            <Label styleClass="text-sub" text="Can be redeemed at any event" />
        </VBox>
        <ToggleButton fx:id="toggleAllEvents" mnemonicParsing="false" styleClass="btn-secondary" text="OFF" />
    </HBox>

    <VBox spacing="8.0">
        <Label styleClass="input-label" text="Event *" />
        <ComboBox fx:id="comboEvents" maxWidth="Infinity" promptText="Select event" styleClass="modern-input" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#onCloseWindow" styleClass="btn-secondary" text="Cancel" />
        <Button fx:id="btnCreate" mnemonicParsing="false" onAction="#onCreateVoucher" styleClass="btn-primary" text="Create Voucher" />
    </HBox>
</VBox>
